# Copie para .env e ajuste. NUNCA versione o .env.
# Todos os valores abaixo têm padrão no docker-compose.yml; só mude o que precisar.
# Para o "docker stack deploy" ler estes valores, exporte-os no terminal:
#   Linux/macOS/Git Bash:  set -a; . ./.env; set +a
#   PowerShell: Get-Content .env | ForEach-Object { if ($_ -match '^(\w+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }

# Banco PostgreSQL do cluster
POSTGRES_DB=conectavida
POSTGRES_USER=conectavida
POSTGRES_PASSWORD=troque-esta-senha

# Segredo usado no hash das senhas (gere um valor longo e aleatório)
CONECTA_API_SALT=SUBSTITUA_POR_UM_SEGREDO_LONGO_E_ALEATORIO
CONECTA_CORS_ORIGINS=http://localhost:5173,http://localhost:8088,http://localhost:8089,http://localhost

# Opcionais
MAIL_USERNAME=
MAIL_PASSWORD=

# Registry e versão das imagens (o script infra/swarm/seminario.sh usa estes padrões)
REGISTRY=127.0.0.1:5000
TAG=1.0

# Réplicas (padrões do docker-compose.yml)
# ADMIN_API_REPLICAS=2
# MOBILE_API_REPLICAS=3
# ADMIN_WEB_REPLICAS=2
# MOBILE_WEB_REPLICAS=2
